# Euhedral's Bazel build of the Rust workspace in rust/ (Java and Zig stay on Gradle). Versions are the table in forge's
# build/module/MODULE.bazel (forge build/CONTRACTS.md C4); forge's check-repo.sh checks the bazel_dep versions below.
module(
    name = "euhedral_euhedral",
    version = "0.0.0",
)

# The euhedral_build module (the shared platforms and tags) is a copy of forge's build/module, loaded through a local path
# until the private registry (C5) is reachable from every runner; bazel/ is in .bazelignore, so its files are not packages
# of this module. It is a dev dependency (used only for the Windows platform label of this repository's own CI), so a module
# that takes this one ignores it and its path override.
bazel_dep(name = "euhedral_build", version = "0.1.0", dev_dependency = True)
local_path_override(
    module_name = "euhedral_build",
    path = "bazel/euhedral_build",
)

# RustEE is a Bazel module, so that a module taking this one and RustEE gets one copy of euhedral-core. Its commit is
# the `rev` of the RustEE dependencies in rust/Cargo.toml: bazel-gen's layout test fails when they differ. A module that
# takes this one pins RustEE itself (an override of a non-root module is ignored). The crate_universe below still resolves
# the RustEE crates of Cargo.lock, but nothing refers to them: the targets use @euhedral_rustee.
bazel_dep(name = "euhedral_rustee", version = "0.0.0")
git_override(
    module_name = "euhedral_rustee",
    remote = "https://github.com/Euhedral-Engine/RustEE.git",
    commit = "880a70a03d94685c74b194efe29d829f1a157495",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_rust", version = "0.75.0")

# The toolchain is rust/rust-toolchain.toml's version (and mise.toml's). rules_rust takes only a literal, so the version is
# written twice; the generator's check (`bazel run //:gazelle -- -mode=diff`) fails when either differs from the toolchain
# file. host_tools is the cargo that crate_universe splices with: rules_rust declares its own at its own version, which
# moves when rules_rust is bumped, so this one has another name and from_cargo is pointed at it.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

rust_host_tools = use_extension("@rules_rust//rust:extensions.bzl", "rust_host_tools")
rust_host_tools.host_tools(
    name = "euhedral_host_tools",
    version = "1.99.1",
)
use_repo(rust_host_tools, "euhedral_host_tools")

register_toolchains("@rust_toolchains//:all")

# crate_universe reads the workspace's Cargo.toml and Cargo.lock (the RustEE crates are git dependencies pinned there);
# Cargo owns Cargo.lock; cargo-bazel-lock.json is crate_universe's own lock, shipped so that a module taking this one needs
# no resolution. Regenerate it after Cargo.lock or a manifest changes: `CARGO_BAZEL_REPIN=1 bazel build //rust/...`.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "euhedral_crates",
    cargo_lockfile = "//rust:Cargo.lock",
    lockfile = "//rust:cargo-bazel-lock.json",
    host_tools = "@euhedral_host_tools",
    manifests = ["//rust:Cargo.toml"],
    supported_platform_triples = [
        "x86_64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
    ],
)
use_repo(crate, "euhedral_crates")
