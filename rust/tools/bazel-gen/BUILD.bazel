# @generated by rust/tools/bazel-gen from the Cargo manifests; do not edit. Regenerate with `bazel run //:gazelle` (the `layout_test` of bazel-gen fails when a file is stale).

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

# Read by the layout test of bazel-gen.
exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

rust_binary(
    name = "bazel-gen",
    crate_name = "bazel_gen",
    crate_root = "src/main.rs",
    data = ["@rules_rust//cargo:current_cargo_toolchain"],
    deps = [
        "@crates//:serde_json",
    ],
    edition = "2024",
    env = {
        "CARGO": "$(rootpath @rules_rust//cargo:current_cargo_toolchain)",
    },
    rustc_env = {
        "CARGO_MANIFEST_DIR": "rust/tools/bazel-gen",
    },
    srcs = glob(
        [
            "src/**/*.rs",
        ],
    ),
    version = "0.1.0",
    visibility = ["//visibility:public"],
)

# The unit tests of the binary bazel-gen.
rust_test(
    name = "bazel-gen_bin_test",
    crate = ":bazel-gen",
    edition = "2024",
    version = "0.1.0",
)

