# @generated by rust/tools/bazel-gen from the Cargo manifests; do not edit. Regenerate with `bazel run //:gazelle` (the `layout_test` of bazel-gen fails when a file is stale).

# `bazel run //:gazelle` writes the BUILD files; `-- -mode=diff` fails and names the stale ones.
alias(
    name = "gazelle",
    actual = "//rust/tools/bazel-gen:bazel-gen",
    visibility = ["//visibility:public"],
)

# Files the crates include with include_str! from outside their package.
exports_files([
    "benchmark/src/main/resources/io/euhedral_execution/inference/benchmark/prompt/chat-corpus-v1-document.md",
    "native/src/trellis/codebook.cuh",
    "quantization/src/main/resources/cuda/drafter.cu",
    "quantization/src/main/resources/cuda/gptq.cu",
    "quantization/src/main/resources/cuda/mtp.cu",
    "quantization/src/main/resources/cuda/rows.cu",
    "quantization/src/main/resources/cuda/score.cu",
    "quantization/src/main/resources/cuda/train.cu",
    "quantization/src/main/resources/cuda/trellis.cu",
])

# The files the layout test of bazel-gen reads.
exports_files(["BUILD.bazel", "MODULE.bazel", "mise.toml"])

# Files outside rust/ that the tests of rust/ read.

filegroup(
    name = "config_example",
    srcs = glob(
        [
            "config/euhedral.example.yaml",
        ],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "benchmark_configs",
    srcs = glob(
        [
            "benchmark/configs/**",
        ],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "gptq_fixture",
    srcs = glob(
        [
            "quantization/src/test/resources/gptq-fixture/**",
        ],
    ),
    visibility = ["//visibility:public"],
)
