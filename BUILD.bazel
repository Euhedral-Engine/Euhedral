# @generated by rust/tools/bazel-gen from the Cargo manifests; do not edit. Regenerate with `bazel run //:gazelle` (the `layout_test` of bazel-gen fails when a file is stale).

# `bazel run //:gazelle` writes the BUILD files; `-- -mode=diff` fails and names the stale ones.
alias(
    name = "gazelle",
    actual = "//rust/tools/bazel-gen:bazel-gen",
    visibility = ["//visibility:public"],
)

# Files the crates include with include_str! from outside their package.
exports_files([
    "native/src/trellis/codebook.cuh",
])

# The files the layout test of bazel-gen reads.
exports_files(["BUILD.bazel", "MODULE.bazel", "mise.toml"])

# Files outside rust/ that the tests of rust/ read.

filegroup(
    name = "config_example",
    srcs = glob(
        [
            "config/euhedral.example.yaml",
        ],
    ),
    visibility = ["//visibility:public"],
)
