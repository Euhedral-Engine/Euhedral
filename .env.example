# Settings for the server container. Copy this file to .env (git ignores it) and fill it in.
# `mise deploy .env` reads it, passes it to Docker, and mounts EUHEDRAL_ARTIFACT_FILE automatically.
# Docker's env-file format: KEY=VALUE, no quotes, comments on lines of their own.

# The artifact on the host, mounted into the container. It carries its tokenizer.
# Relative paths resolve from this file's directory.
EUHEDRAL_ARTIFACT_FILE=/path/to/qwen3_8_27b_nvfp4_compressed.edrl

# The name clients send as "model".
EUHEDRAL_MODEL_NAME=qwen
# Processor IDs for the engine's worker threads: IDs or inclusive ranges, for example 2-5,8.
EUHEDRAL_HOST_CPUS=2-5
# The port the server listens on; the deploy script publishes it on 127.0.0.1.
PORT=1738

# Optional server settings, shown with their defaults (docs/OPERATIONS.md lists them all).
# Every key of config/euhedral.example.yaml is a variable: EUHEDRAL_ plus the key path in capitals.
# EUHEDRAL_CONTEXT_MAX_TOKENS=32768
# EUHEDRAL_PREFIX_CACHE_SIZE=4GiB
# EUHEDRAL_SERVER_REQUESTS_DEFAULT_MAX_TOKENS=4096
# EUHEDRAL_SERVER_REQUESTS_MAX_QUEUED=16

# Optional overrides for host driver discovery. Without Docker NVIDIA runtime/CDI support, deploy automatically
# discovers these libraries and mounts them with the GPU device nodes. Set both to choose explicit library paths.
# EUHEDRAL_CUDA_DRIVER_FILE=/usr/lib/x86_64-linux-gnu/libcuda.so.1
# EUHEDRAL_PTX_JIT_FILE=/usr/lib/x86_64-linux-gnu/libnvidia-ptxjitcompiler.so.1
